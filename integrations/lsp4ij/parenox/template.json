{
  "id": "parenox",
  "name": "Parenox",
  "programArgs": {
    "default": "\"$USER_HOME$/.cargo/bin/parenox\" lsp",
    "windows": "\"$USER_HOME$/.cargo/bin/parenox.exe\" lsp"
  },
  "fileTypeMappings": [
    {
      "fileType": { "patterns": ["*.clj", "*.cljc", "*.cljs"] },
      "languageId": "clojure"
    },
    {
      "fileType": { "patterns": ["*.edn"] },
      "languageId": "edn"
    }
  ]
}
